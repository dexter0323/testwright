{
  "name": "testwright",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-assisted Playwright UI and API testing across applications.",
  "scripts": {
    "test": "node scripts/run-tests.ts",
    "app:setup": "node scripts/setup-app.ts",
    "apps:validate": "node scripts/validate-apps.ts",
    "test:app": "node scripts/run-tests.ts",
    "test:app:ci": "node scripts/run-tests.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs": "bash scripts/docs/run.sh",
    "docs:serve": "bash scripts/docs/run.sh --serve",
    "docs:build": "bash scripts/docs/run.sh --build"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.22",
    "@playwright/mcp": "^0.0.83",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "yaml": "^2.8.1",
    "typescript": "^5.9.0"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=26.10.0",
    "pnpm": ">=12.8.1"
  }
}
